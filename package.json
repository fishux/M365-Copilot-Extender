{
  "name": "m365-copilot-extender",
  "version": "0.3.0",
  "private": true,
  "description": "Dependency-free Chrome extension for persistent Copilot model selection.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package": "npm run check && python3 scripts/package.py",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "typescript": "7.0.2"
  }
}
