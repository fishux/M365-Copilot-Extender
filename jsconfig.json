{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/types.d.ts"]
}
